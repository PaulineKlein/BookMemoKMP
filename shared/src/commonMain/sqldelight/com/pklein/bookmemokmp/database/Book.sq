CREATE TABLE IF NOT EXISTS Book (
    id             INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    type           TEXT    NOT NULL,
    title          TEXT    NOT NULL,
    author         TEXT,
    illustrator    TEXT,
    year           INTEGER,
    bought         INTEGER NOT NULL DEFAULT 0,
    wishlist       INTEGER NOT NULL DEFAULT 0,
    finish         INTEGER NOT NULL DEFAULT 0,
    tome           INTEGER,
    chapter        INTEGER,
    episode        INTEGER,
    season         INTEGER,
    desc           TEXT,
    favorite       INTEGER NOT NULL DEFAULT 0,
    image_url      TEXT,
    is_borrowed    INTEGER NOT NULL DEFAULT 0,
    borrowed_since INTEGER,
    borrowed_by    TEXT,
    jikan_id       INTEGER,
    jikan_type     TEXT,
    tot_tome       INTEGER,
    tot_chapter    INTEGER,
    tot_episode    INTEGER,
    checked_tomes  TEXT AS kotlin.collections.List<kotlin.Int>,
    notes          TEXT
);

selectAll:
SELECT * FROM Book ORDER BY title COLLATE NOCASE ASC;

selectById:
SELECT * FROM Book WHERE id = ?;

selectByType:
SELECT * FROM Book WHERE type = ? ORDER BY title COLLATE NOCASE ASC;

selectFavorites:
SELECT * FROM Book WHERE favorite = 1 ORDER BY title COLLATE NOCASE ASC;

insert:
INSERT INTO Book (type, title, author, illustrator, year, bought, wishlist, finish, tome, chapter, episode, season, desc, favorite, image_url, is_borrowed, borrowed_since, borrowed_by, jikan_id, jikan_type, tot_tome, tot_chapter, tot_episode, checked_tomes, notes)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

update:
UPDATE Book SET
    type           = ?,
    title          = ?,
    author         = ?,
    illustrator    = ?,
    year           = ?,
    bought         = ?,
    wishlist       = ?,
    finish         = ?,
    tome           = ?,
    chapter        = ?,
    episode        = ?,
    season         = ?,
    desc           = ?,
    favorite       = ?,
    image_url      = ?,
    is_borrowed    = ?,
    borrowed_since = ?,
    borrowed_by    = ?,
    jikan_id       = ?,
    jikan_type     = ?,
    tot_tome       = ?,
    tot_chapter    = ?,
    tot_episode    = ?,
    checked_tomes  = ?,
    notes          = ?
WHERE id = ?;

updateTotals:
UPDATE Book SET
    tot_tome       = ?,
    tot_chapter    = ?,
    tot_episode    = ?
WHERE id = ?;

updateLoan:
UPDATE Book SET
    is_borrowed    = ?,
    borrowed_since = ?,
    borrowed_by    = ?
WHERE id = ?;

delete:
DELETE FROM Book WHERE id = ?;

search:
SELECT * FROM Book
WHERE title LIKE '%' || :query || '%'
   OR author LIKE '%' || :query || '%'
   OR illustrator LIKE '%' || :query || '%'
   OR desc LIKE '%' || :query || '%'
ORDER BY title COLLATE NOCASE ASC;

existsByTitleAndType:
SELECT COUNT(*) FROM Book
WHERE title = :title COLLATE NOCASE
  AND type = :type
  AND id != :excludeId;

lastInsertRowId:
SELECT last_insert_rowid();
